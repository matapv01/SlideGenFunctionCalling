GEMINI_API_KEY=""
GEMINI_GENERATION_MODEL="gemini-2.5-flash"
TAVILY_API_KEY1=""
TAVILY_API_KEY2=""
TAVILY_API_KEY3=""

# Application settings
SECRET_KEY=your_secret_key_here

# ViT aesthetic checkpoint
VIT_MODEL_DIR=models/vit
VIT_MODEL_FILENAME=best_model_multilabel_DX_10_0.77.pt
# ViT evaluator is kept in code but disabled by default.
ENABLE_VIT_EVALUATION=false
# Rule-based textbox overflow resolver limits
TEXT_OVERFLOW_MAX_ROUNDS=2
TEXT_OVERFLOW_MAX_BOXES_PER_ROUND=12

# Maximum fallback regenerations after the bounded overflow repair loop.
EXECUTOR_MAX_RETRIES=2

# Browser PNG capture resolution (2 = HiDPI output)
BROWSER_DEVICE_SCALE_FACTOR=2
BROWSER_PREVIEW_URL=http://127.0.0.1:12008/render/xml-preview

# Optional overrides (defaults shown)
LOG_LEVEL=INFO
EMBEDDING_DEVICE=cuda

# Frontend API URL — baked into the bundle at build time
VITE_API_BASE_URL=/api/v1

# Backend URL for nginx reverse proxy (docker/nginx.conf.template)
BACKEND_URL=http://slidegen:12008
HOST_NAME="https://discrete-gorgeous-spanking-subscribers.trycloudflare.com"
API_TIMEOUT="600"
# Local LLM overrides (uncomment to use local serving instead of Gemini)
# Đổi mô hình to: thay Qwen/Qwen2.5-Coder-0.5B-Instruct thành Qwen/Qwen3.6-35B-A3B
LLM_BASE_URL=http://localhost:8008/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct
# IDEA_STRUCTURE_LLM_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct # planning node

# RL Training Settings
# Đổi mô hình to: thay Qwen/Qwen2.5-Coder-0.5B-Instruct hoặc Qwen/Qwen3-4B-Instruct-2507 thành Qwen/Qwen3.6-35B-A3B
# https://huggingface.co/Salesforce/xLAM-2-3b-fc-r
TRAINING_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
TRAINING_GPU=1
REWARD_MODEL_DEVICE=cpu
SDFT_USE_VLLM=false

# GRPO tự load rl/data/step_XXXX_adapter mới nhất và chạy tiếp từ step kế tiếp.
GRPO_RESUME=true
# Giảm nếu OOM lúc model.generate.
MAX_COMPLETION_LENGTH=1024
NUM_GENERATIONS=2
