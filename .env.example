GEMINI_API_KEY =""
TAVILY_API_KEY1=""
TAVILY_API_KEY2=""
TAVILY_API_KEY3=""

LLM_API_KEY=""
# VLM verifier credential. Temporarily use the same value as LLM_API_KEY.
VLM_API_KEY=""
# OpenAI-compatible Qwen endpoint.
# Docker + Qwen chạy trên host: http://host.docker.internal:8080/v1
# Docker + Qwen chạy cùng compose: http://<qwen-service>:8000/v1
# Backend chạy trực tiếp trên host: http://127.0.0.1:8080/v1
LLM_BASE_URL="http://host.docker.internal:8080/v1"

SECRET_KEY=your_secret_key_here

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Production: https://ptitai.org/api/v1/auth/google/callback
# Local Docker: http://localhost:8082/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
# Production: https://ptitai.org/slidegen
# Local Docker: http://localhost:8082/slidegen
GOOGLE_FRONTEND_URL=

# SMTP is required for email verification after password and Google sign-in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-smtp-user@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=45
AUTH_OTP_MAX_ATTEMPTS=5
