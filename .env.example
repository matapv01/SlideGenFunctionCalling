GEMINI_API_KEY=your_key_here
TAVILY_API_KEY1=your_key_here
TAVILY_API_KEY2=your_key_here
TAVILY_API_KEY3=your_key_here

# Application settings
SECRET_KEY=your_secret_key_here

# Optional overrides (defaults shown)
LOG_LEVEL=INFO
DISABLE_CONVERTER=0
EMBEDDING_DEVICE=cuda

# Frontend API URL — baked into the bundle at build time
# Use relative path so the build works on any domain/IP without rebuilding
VITE_API_BASE_URL=/api/v1

# Backend URL for nginx reverse proxy (docker/nginx.conf.template)
# Single server (FE + BE same machine): http://slidegen:12008 # Docker internal
# Split servers (BE on separate machine): http://be-server-ip-or-domain:12008
BACKEND_URL=http://slidegen:12008

# Local LLM overrides (uncomment to use local serving instead of Gemini)
# Đổi mô hình to: thay Qwen/Qwen2.5-Coder-0.5B-Instruct thành Qwen/Qwen3.6-35B-A3B
# LLM_BASE_URL=http://localhost:8008/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct
# IDEA_STRUCTURE_LLM_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct

# RL Training Settings
# Đổi mô hình to: thay Qwen/Qwen2.5-Coder-0.5B-Instruct thành Qwen/Qwen3.6-35B-A3B
# TRAINING_MODEL_ID=Qwen/Qwen2.5-Coder-0.5B-Instruct
# REWARD_MODEL_DEVICE=cpu