    <textbox x="120" y="193.68" width="690" height="148.8" font="Arial" size="20.0" min_font_size="20.0" color="#FFFFFF" align="left" vertical_align="top" single_line="false" max_lines="4" overflow="clip" line_spacing="1.05" safety_ratio="1.0" margin_left="0" margin_right="0" margin_top="0" margin_bottom="0">Lionel Messi được mệnh danh là một trong
